# 复制这个文件为 .env，然后按需填写
# 命令：copy .env.example .env

# ===== 应用 =====
APP_NAME=ContractGuard
DEBUG=true

# ===== 数据库 =====
# 阶段 0 用 SQLite，文件会自动生成在项目根目录，不需要安装任何数据库服务
DATABASE_URL=sqlite:///./contractguard.db
#
# 以后想换 PostgreSQL，改这一行即可（记得同时 pip install psycopg2-binary）：
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/contractguard
#
# 想换 MySQL（记得 pip install pymysql cryptography）：
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/contractguard

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# ===== DeepSeek（阶段 2 需要，去 platform.deepseek.com 申请）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding（阶段 5 需要，去 siliconflow.cn 申请，有免费额度）=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== Redis（阶段 3：任务进度 / 分布式锁 / 报告缓存）=====
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=cg
TASK_TTL_SECONDS=3600
CACHE_TTL_SECONDS=300

# ===== Eureka 注册中心（服务发现，Java 侧靠它发现 AI-SERVICE）=====
# 是否注册到 Eureka；本地不想开 Eureka 时设为 false
EUREKA_ENABLED=true
# Eureka 服务端地址（对应 Java 侧 eureka-server，端口 8761）
EUREKA_URL=http://localhost:8761
# AI 服务对外端口（与 uvicorn 启动端口保持一致）
AI_SERVICE_PORT=8000
